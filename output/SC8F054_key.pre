# 9 "D:\QW\QW-项目\QW-247\程序\手环-中微-程序-16通道-2.4G\QW-247_SC8F054_V1.0_16M2T_16Channel\SC8F054_key.c"
void Key_Scan(void)
{
if (RB0)
{
if(!key_control.key_down_pb)
{
key_control.key_rec_flag_pb = 1;
key_control.key_up_pb = 0;
key_control.key_down_pb = 1;
key_control.key_down_time_pb = 0;
key_control.key_up_time_pb = 0;
key_control.key_flag_pb = 0;
key_control.key_long_flag_pb = 0;
key_control.key_pb = 0;
}
else
{
if((key_control.key_down_time_pb > 70) && !key_control.key_flag_pb)
{
key_control.key_flag_pb = 1;
}
if((key_control.key_down_time_pb > 1000) && !key_control.key_long_flag_pb)
{
key_control.key_long_flag_pb = 1;
key_control.key_pb = 1;
}
}
}
else
{

if(!key_control.key_up_pb)
{
key_control.key_up_pb = 1;
key_control.key_up_time_pb = 0;
}
else
{
if(key_control.key_up_time_pb > 50)
{
key_control.key_down_pb = 0;
if(key_control.key_flag_pb && (key_control.key_long_flag_pb == 0))
{
key_control.key_rec_flag_pb = 0;
key_control.key_flag_pb = 0;
key_control.key_pb = 1;
}
}
}
}
}

# 65
void Key_Event(void)
{
if(key_control.key_pb && key_control.key_long_flag_pb)
{
key_control.key_pb = 0;
if(!soft_recieve_control.recieve_bit)
{
led_control.led_color = 0;
led_control.led_mode = 0;
sleep_control.sleep_count = 3;
sleep_control.sleep_flag = 1;
sleep_control.recieve_sleep_flag = 0;
}
}
else if(key_control.key_pb == 1)
{
key_control.key_pb = 0;
if(!soft_recieve_control.recieve_bit)
{
sleep_control.sleep_count = 20;
sleep_control.recieve_sleep_flag = 1;
soft_recieve_control.randnum_flag = 0;

if(led_control.led_mode == 16)
{
led_control.led_color = 0;
led_control.led_mode = 2;
}
else
{
led_control.led_color++;
if(led_control.led_color >= 16)
{
led_control.led_mode = 16;
}
}


}
}
}

# 113
void Key_Check_Time(void)
{
if(key_control.key_down_pb)
{
key_control.key_down_time_pb++;
if(key_control.key_down_time_pb >= 3000)
{
key_control.key_down_time_pb = 3000;
}
}
if(key_control.key_up_pb)
{
key_control.key_up_time_pb++;
if(key_control.key_up_time_pb >= 255)
{
key_control.key_up_time_pb = 255;
}
}
}

