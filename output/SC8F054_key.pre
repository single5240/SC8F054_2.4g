} SOFT_RECIEVE_CONTROL;


extern SLEEP_CONTROL sleep_control;
extern SOFT_RECIEVE_CONTROL soft_recieve_control;
extern KEY_CONTROL key_control;
extern LED_CONTROL led_control;
