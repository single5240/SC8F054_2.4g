unsigned char breat_time_control;
unsigned char quick_control;
unsigned char add_data;
} LED_CONTROL;

typedef struct
{
unsigned jump_flag : 1;
unsigned recieve_bit : 1;
unsigned clear_bit : 1;
unsigned rand_flag : 1;
