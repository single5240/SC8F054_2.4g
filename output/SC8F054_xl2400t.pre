# 11
static void RF_SPI_Write_Byte(unsigned char buff)
{
unsigned char i = 0;
TRISB = 0B00000000;
for(i = 0; i < 8; i++)
{
RB4 = 0;

if(buff & 0x80)
{
RB5 = 1;
}
else
{
RB5 = 0;
}

buff = buff << 1;
RB4 = 1;
}

RB5 = 1;
RB4 = 0;
}

# 40
static unsigned char RF_SPI_Read_Byte(void)
{
TRISB = 0B00100000;
unsigned char buff = 0;
unsigned char i = 0;

for(i = 0; i < 8; i++)
{
RB4 = 0;
buff = buff << 1;
RB4 = 1;
if(RB5)
{
buff |= 0x01;
}
}
RB4 = 0;
return buff;
}

# 65
void RF_SPI_Write_Reg(unsigned char RF_Reg, unsigned char W_Data)
{
RB0 = 0;
RF_SPI_Write_Byte(RF_Reg);
RF_SPI_Write_Byte(W_Data);
RB0 = 1;
}

# 78
unsigned char RF_SPI_Read_Reg(unsigned char RF_Reg)
{
unsigned char rTemp = 0;
RB0 = 0;
RF_SPI_Write_Byte(RF_Reg);
rTemp = RF_SPI_Read_Byte();
RB0 = 1;
return rTemp;
}

# 94
void RF_Write_Buff(unsigned char RF_Reg, unsigned char *pBuff, unsigned char Len)
{
unsigned char rTemp = 0;
unsigned char i = 0;

RB0 = 0;
RF_SPI_Write_Byte(RF_Reg);
for(i = 0; i < Len; i++)
{
rTemp = pBuff[i];
RF_SPI_Write_Byte(rTemp);
}
RB0 = 1;
}

# 115
void RF_Read_Buff(unsigned char RF_Reg, unsigned char *pBuff, unsigned char Len)
{
unsigned char i=0;
RB0 = 0;
RF_SPI_Write_Byte(RF_Reg);
for(i = 0 ; i < Len ; i++)
{
pBuff[i] = RF_SPI_Read_Byte();
}
RB0 = 1;
}

# 130
void RF_CE_High(void)
{
RF_SPI_Write_Reg(0x20 + (0X00), 0xEF);
}

# 138
void RF_CE_Low(void)
{
RF_SPI_Write_Reg(0x20 + (0X00), 0xEE);
}

# 148
void RF_Refresh_State(void)
{
RF_SPI_Write_Reg(0x20 + (0X07), 0x70);
RF_SPI_Write_Reg(0xE1, 0xFF);
RF_SPI_Write_Reg(0xE2, 0xFF);
}

# 159
void RF_Set_Chn(unsigned char Chn)
{
unsigned temp = 0;
temp = RF_SPI_Read_Reg((0X01));
temp &= ~(1 << 6);
RF_SPI_Write_Reg(0x20 + (0X01), temp);
RF_SPI_Write_Reg(0x20 + (0X05), Chn + 0x60);
temp = 0;
temp = RF_SPI_Read_Reg(0x00 | 0x01);
temp |= (1<<6);
RF_SPI_Write_Reg(0x20 + (0X01), temp);
}

# 175
void RF_Set_Address(unsigned char *AddrBuff)
{
RF_Write_Buff(0x20 + (0X10), AddrBuff, 5);
RF_Write_Buff(0x20 + (0X0A), AddrBuff, 5);
}

# 184
void RF_Reset(void)
{
RF_SPI_Write_Reg(0x20 + (0X00),0xEA);
Delay_ms(1);
RF_SPI_Write_Reg(0x20 + (0X00),0xEE);
Delay_ms(1);
}

# 195
void RF_Set_Power(unsigned char Power)
{
unsigned char Power_Buff[3]={0};
RF_Read_Buff((0X06), Power_Buff, 2);
Power_Buff[1] = Power;
RF_Write_Buff(0x20 + (0X06), Power_Buff ,2);
}

# 206
void RF_Tx_Mode(void)
{
unsigned char Mode_Buff[3] = {0};
Mode_Buff[0] = 0xee;
Mode_Buff[1] = 0x80;
RF_Write_Buff(0x20 + (0X00), Mode_Buff, 2);
RF_Read_Buff((0X00), Mode_Buff, 3);
RF_Refresh_State();
Delay_ms(10);
RF_Set_Chn(76);
}

# 221
void RF_Rx_Mode(void)
{
unsigned char Mode_Buff[3] = {0};
Mode_Buff[0] = 0xee;
Mode_Buff[1] = 0xc0;
RF_Write_Buff(0x20 + (0X00), Mode_Buff, 2);
RF_Read_Buff((0X00), Mode_Buff, 3);
RF_Refresh_State();
RF_CE_High();
RF_Read_Buff((0X00), Mode_Buff, 3);
Delay_ms(10);
RF_Set_Chn(76-1);
}

unsigned char color_t = 0;
unsigned char RF_TX_Data(unsigned char* tx_buff)
{
unsigned char Temp = 0;

RF_Refresh_State();
color_t++;
if(color_t > 15)
color_t = 0;

tx_buff[0] = (0xff & 0x0ff);
tx_buff[1] = ((0xff >> 8) & 0x0ff);
tx_buff[2] = ((color_t << 4) | 2);
tx_buff[3] = (0x20);
tx_buff[4] = ((tx_buff[0] + tx_buff[1] + tx_buff[2] + tx_buff[3]) & 0x0ff);
RF_Write_Buff(0xA0, tx_buff, 5);

UART_Send_Byte(tx_buff[0]);
UART_Send_Byte(tx_buff[1]);
UART_Send_Byte(tx_buff[2]);
UART_Send_Byte(tx_buff[3]);
UART_Send_Byte(tx_buff[4]);

RF_CE_High();
Delay_1ms();
RF_CE_Low();
Delay_1ms();

Temp = RF_SPI_Read_Reg((0X07));
UART_Send_Byte(Temp);


if(RF_SPI_Read_Reg((0X07)) & (0x20))
{
RF_Refresh_State();
return 0x20;
}
else
{
RF_Refresh_State();
return 0;
}
}

unsigned char key_count = 0;

# 285
unsigned char RF_RX_Data(unsigned char* rx_buff)
{
TRISB = 0B00000000;
if(key_control.key_rec_flag_pb == 0)
{
if(RF_SPI_Read_Reg((0X07)) & (0x40))
{
RF_CE_Low();
soft_recieve_control.data_length_count = RF_SPI_Read_Reg(0x60);
RB0 = 0;
RF_SPI_Write_Byte(0x61);
rx_buff[0] = RF_SPI_Read_Byte();
rx_buff[1] = RF_SPI_Read_Byte();
rx_buff[2] = RF_SPI_Read_Byte();
rx_buff[3] = RF_SPI_Read_Byte();
rx_buff[4] = RF_SPI_Read_Byte();
RB0 = 1;
Soft_Decode();
RF_Refresh_State();
RF_CE_High();
}
}

Delay_3us();
TRISB = 0B00000001;
Delay_3us();
Key_Scan();
Key_Event();
Delay_3us();
}


void XL2400T_Init(void)
{
unsigned char dat = 0;
Delay_ms(150);

RF_SPI_Write_Reg(0x20 + (0X00), 0x02);
Delay_1ms();
RF_SPI_Write_Reg(0x20 + (0X00), 0x3e);
Delay_1ms();

unsigned char gRfBuffer[8] = {0};
gRfBuffer[5] = ((gRfBuffer[5] & 0xff) | 0x6d);
RF_Read_Buff((0X0F), gRfBuffer, 5);
Delay_ms(1);
gRfBuffer[0] = 0x44;
gRfBuffer[1] = 0x3E;
gRfBuffer[2] = 0x38;
gRfBuffer[3] = 0x32;
gRfBuffer[4] = 0x2A;
RF_Write_Buff(0x20 + (0X0F), gRfBuffer, 5);
Delay_1ms();

RF_SPI_Write_Reg(0x20 + (0X03), 0xAF);
RF_Set_Address(RF_Test_Adrress);
RF_SPI_Write_Reg(0x20 + (0X06), 0x22);
RF_SPI_Write_Reg(0x20 + (0X02), 0x01);
RF_SPI_Write_Reg(0x20 + (0X11), 5);
RF_SPI_Write_Reg(0x20 + (0X01), 0x00);
RF_SPI_Write_Reg(0x20 + (0X1C), 0x00);
RF_SPI_Write_Reg(0x20 + (0X1D), 0x18);
RF_SPI_Write_Reg(0x20 + (0X04),0x33);
RF_Set_Power(12);
}

