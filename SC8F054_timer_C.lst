  06CC    01D2    CLR	0x52
  06CD    084E    LD	A,0x4E
  06CE    0252    SUBA	0x52
  06CF    1803    SZB	0x3,0
  06D0    2EDB    JP	0x6DB
102:              	{
103:              		rTemp = pBuff[i];
  06D1    0852    LD	A,0x52
  06D2    074D    ADDA	0x4D
  06D3    00CF    LD	0x4F,A
  06D4    0084    LD	0x4,A
  06D5    1383    CLRB	0x3,7
  06D6    0800    LD	A,0x0
  06D7    00D1    LD	0x51,A
104:                      RF_SPI_Write_Byte(rTemp);
  06D8    26DD    CALL	0x6DD
  06D9    0AD2    INCR	0x52
  06DA    2ECD    JP	0x6CD
105:              	}
106:              	CSN = 1;
  06DB    1406    SETB	0x6,0
  06DC    0008    RET
107:              }
