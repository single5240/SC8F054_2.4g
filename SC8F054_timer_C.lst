60:               /********************************************************************
61:                * 向XL2400T的寄存器写入一个字节的数据
62:                * 参数：RF_Reg 写指令|寄存器地址
63:                * 参数：W_Data 写入的数据
64:               *********************************************************************/
65:               void RF_SPI_Write_Reg(unsigned char RF_Reg, unsigned char W_Data)
66:               {
67:               	CSN = 0;
  07B8    1006    CLRB	0x6,0
68:               	RF_SPI_Write_Byte(RF_Reg); // 写入地址
  07B9    26DD    CALL	0x6DD
69:               	RF_SPI_Write_Byte(W_Data); // 写入数据
  07BA    084D    LD	A,0x4D
  07BB    26DD    CALL	0x6DD
70:               	CSN = 1;
  07BC    1406    SETB	0x6,0
  07BD    0008    RET
71:               }
72:               
73:               /*******************************************************
74:                * 从XL2400T寄存器读取一个字节的数据
75:                * 参数: 读指令|寄存器地址
76:                * 返回值：读取到的数据
77:               ********************************************************/
78:               unsigned char RF_SPI_Read_Reg(unsigned char RF_Reg)
79:               {
80:               	unsigned char rTemp = 0;
81:               	CSN = 0;
  07B1    1006    CLRB	0x6,0
82:               	RF_SPI_Write_Byte(RF_Reg);  // 写入地址+读取指令
  07B2    26DD    CALL	0x6DD
83:               	rTemp = RF_SPI_Read_Byte(); // 读取数据
  07B3    2717    CALL	0x717
  07B4    00CE    LD	0x4E,A
84:               	CSN = 1;
  07B5    1406    SETB	0x6,0
85:               	return rTemp;
  07B6    0008    RET
86:               }
