27:                * 函数功能： 随机数生成处理函数
28:                * 功能说明： 该函数用于在满足特定条件时生成1~8范围内的有效随机数，存入控制结构体中，
29:                *            采用「先初始化随机数种子，再生成随机数，最后做范围校验」的流程，保证随机数的有效性和唯一性。
30:                */
31:               void Rand_num(void)
32:               {
33:               	if((soft_recieve_control.rand_flag == 0) && (soft_recieve_control.randnum_flag == 1))
  078B    1DB6    SNZB	0x36,3
  078C    1EB6    SNZB	0x36,5
  078D    0008    RET
34:                   {	
35:               		soft_recieve_control.rand_num  = (rand() % 8) + 1;
  078E    25DC    CALL	0x5DC
  078F    0857    LD	A,0x57
  0790    3907    ANDIA	0x7
  0791    3E01    ADDIA	0x1
  0792    00C3    LD	0x43,A
36:               		soft_recieve_control.rand_flag = 1;
  0793    15B6    SETB	0x36,3
  0794    0008    RET
37:                   }
38:               }
