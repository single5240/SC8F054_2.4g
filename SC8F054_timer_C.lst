234:              
235:              unsigned char color_t = 0;
236:              unsigned char RF_TX_Data(unsigned char* tx_buff)
237:              {
238:              	unsigned char Temp = 0;
239:              	
240:                  RF_Refresh_State();               	 // 刷新状态
241:              	color_t++;
242:              	if(color_t > 15)
243:              		color_t = 0;
244:              
245:              	tx_buff[0] = (0xff & 0x0ff);        // 选中全部手环（通道）
246:              	tx_buff[1] = ((0xff >> 8) & 0x0ff);
247:              	tx_buff[2] = ((color_t << 4) | 2);  // 颜色+模式   
248:              	tx_buff[3] = (0x20);                    
249:              	tx_buff[4] = ((tx_buff[0] + tx_buff[1] + tx_buff[2] + tx_buff[3]) & 0x0ff);                
250:              	RF_Write_Buff(W_TX_PLOAD, tx_buff, 5); // 填写发送内容
251:              	
252:              	UART_Send_Byte(tx_buff[0]); 
253:              	UART_Send_Byte(tx_buff[1]); 
254:              	UART_Send_Byte(tx_buff[2]); 
255:              	UART_Send_Byte(tx_buff[3]); 
256:              	UART_Send_Byte(tx_buff[4]); 
257:              	
258:              	RF_CE_High(); // 拉高CE
259:              	Delay_1ms();
260:              	RF_CE_Low();  // 拉低CE
261:              	Delay_1ms();
262:              	
263:              	Temp = RF_SPI_Read_Reg(RF_STATUS);
264:              	UART_Send_Byte(Temp); 
265:              
266:              	// 获取状态寄存器的状态
267:              	if(RF_SPI_Read_Reg(RF_STATUS) & TX_DS) // 触发发送中断
268:              	{
269:              		RF_Refresh_State(); // 清空FIFO 清除中断标记位
270:              		return 0x20;
271:              	}
272:              	else
273:              	{
274:              		RF_Refresh_State(); // 清空FIFO 清除中断标记位
275:              		return 0;	
276:              	}
277:              }
278:              
279:              unsigned char key_count = 0;
280:              /*************************************************
281:               * 接收数据函数
282:               * 参数：接收到的数据 存放的地址
283:               * 返回值：接收到数据返回1 没接收到数据返回0
284:              **************************************************/
285:              unsigned char RF_RX_Data(unsigned char* rx_buff)
286:              {
