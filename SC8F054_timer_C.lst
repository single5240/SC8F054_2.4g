120:              	for(i = 0 ; i < Len ; i++)
  06F5    01D1    CLR	0x51
  06F6    084E    LD	A,0x4E
  06F7    0251    SUBA	0x51
  06F8    1803    SZB	0x3,0
  06F9    2F03    JP	0x703
121:              	{
122:              		pBuff[i] = RF_SPI_Read_Byte();
  06FA    0851    LD	A,0x51
  06FB    074D    ADDA	0x4D
  06FC    00CF    LD	0x4F,A
  06FD    0084    LD	0x4,A
  06FE    2717    CALL	0x717
  06FF    1383    CLRB	0x3,7
  0700    0080    LD	0x0,A
  0701    0AD1    INCR	0x51
  0702    2EF6    JP	0x6F6
123:              	}
124:              	CSN = 1;
  0703    1406    SETB	0x6,0
  0704    0008    RET
125:              }
