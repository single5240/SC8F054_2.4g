8:                /*************************************************
9:                 * SPI写入一个字节的数据
10:               **************************************************/
11:               static void RF_SPI_Write_Byte(unsigned char buff)
12:               {
13:               	unsigned char i = 0;
  06DE    01CC    CLR	0x4C
14:               	TRISB  = 0B00000000;
  06DF    0185    CLR	0x5
15:                   for(i = 0; i < 8; i++)
  06E0    01CC    CLR	0x4C
16:               	{
17:                       SCK = 0;
  06E1    1206    CLRB	0x6,4
18:               		
19:                       if(buff & 0x80)
  06E2    1FCB    SNZB	0x4B,7
  06E3    2EE6    JP	0x6E6
20:               		{
21:                           DATA = 1;
  06E4    1686    SETB	0x6,5
22:               		}
  06E5    2EE7    JP	0x6E7
23:                       else
24:               		{
25:                           DATA = 0;
  06E6    1286    CLRB	0x6,5
26:               		}
27:               		
28:                       buff = buff << 1;
  06E7    1003    CLRB	0x3,0
  06E8    0DCB    RLCR	0x4B
29:                       SCK = 1;
  06E9    1606    SETB	0x6,4
  06EA    3008    LDIA	0x8
  06EB    0ACC    INCR	0x4C
  06EC    024C    SUBA	0x4C
  06ED    1C03    SNZB	0x3,0
  06EE    2EE1    JP	0x6E1
30:                   }
31:               	
32:                   DATA = 1;
  06EF    1686    SETB	0x6,5
33:                   SCK = 0;
  06F0    1206    CLRB	0x6,4
  06F1    0008    RET
34:               }
35:               
36:               /************************************************
37:                * SPI读取一个字节的数据
38:                * 返回值: 读取到的数据
39:               *************************************************/
40:               static unsigned char RF_SPI_Read_Byte(void)
41:               {
42:               	TRISB  = 0B00100000;
  0717    3020    LDIA	0x20
  0718    0085    LD	0x5,A
43:                   unsigned char  buff = 0;
  0719    01CB    CLR	0x4B
44:               	unsigned char  i    = 0;
45:               
46:                   for(i = 0; i < 8; i++)
  071A    01CC    CLR	0x4C
47:                   {
48:                       SCK = 0;
  071B    1206    CLRB	0x6,4
49:                       buff = buff << 1;
  071C    1003    CLRB	0x3,0
  071D    0DCB    RLCR	0x4B
50:                       SCK = 1;
  071E    1606    SETB	0x6,4
51:                       if(DATA)
  071F    1A86    SZB	0x6,5
52:               		{
53:               			buff |= 0x01;
  0720    144B    SETB	0x4B,0
  0721    3008    LDIA	0x8
  0722    0ACC    INCR	0x4C
  0723    024C    SUBA	0x4C
  0724    1C03    SNZB	0x3,0
  0725    2F1B    JP	0x71B
54:               		}         
55:                   }
56:                   SCK = 0;
  0726    1206    CLRB	0x6,4
57:                   return buff;
  0727    084B    LD	A,0x4B
  0728    0008    RET
58:               }
